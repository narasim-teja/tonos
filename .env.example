# Copy to .env and fill in. .env is gitignored; never commit real values.

# Optional: the live WHOOP API. Register your own app at developer.whoop.com with the
# redirect URI http://127.0.0.1:8765/callback, the read:* scopes and offline.
# tonos ships no WHOOP credentials (WHOOP API Terms: no credentials in open-source projects).
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Optional: where tonos keeps its data. Defaults to ~/.tonos.
# TONOS_HOME=
