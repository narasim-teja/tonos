{
  "name": "tonos",
  "version": "0.1.0",
  "private": true,
  "description": "Your own WHOOP export as a local record for you and your agents: CLI, loopback MCP, and HL7 FHIR PHR export.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "bin": {
    "tonos": "src/cli.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test",
