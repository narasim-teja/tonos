    "docs": "bun scripts/docs.ts",
    "validate:fhir": "bun scripts/validate-fhir.ts",
    "serve": "bun src/cli/main.ts serve"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "hono": "4.13.19",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/fhir": "0.0.44",
    "typescript": "^7.0.2"
  }
